{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "copy:ocr": "node scripts/copy-ocr-assets.mjs",

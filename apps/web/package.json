    "bench:ocr": "npm run copy:ocr && node scripts/bench-ocr.mjs",
    "gen:contratos": "node scripts/generar-contratos-escaneados.mjs",
    "bench:contratos": "npm run copy:ocr && node scripts/bench-ocr.mjs --banco=contratos",
    "predev": "npm run copy:ocr",
    "prebuild": "npm run copy:ocr",
    "pretest": "npm run copy:ocr"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "hugeicons-react": "^0.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
